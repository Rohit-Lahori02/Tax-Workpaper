# Postgres connection string. Either:
#   - Neon (hosted):  copy it from the Neon console; the app uses Neon's HTTP driver automatically
#   - Local Docker:   postgresql://postgres:postgres@localhost:5432/workpaper
# Copy this file to .env.local and paste your own value. Never commit .env.local.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: force a driver ("neon" or "postgres"). Detected from the host by default.
# DATABASE_DRIVER=

# Optional: absolute path to a different packet file. Defaults to ./data/packet.json
# PACKET_PATH=
